{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "periScope",
  "version": "0.1.0",
  "identifier": "app.periscope.crosshair",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "periScope",
        "width": 1300,
        "height": 1000,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "shortDescription": "Custom crosshair overlay",
    "longDescription": "A lightweight, native Windows crosshair overlay with a modern settings interface."
  }
}
