{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "periScope",
  "version": "0.4.0",
  "identifier": "app.periscope.crosshair",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "periScope",
        "width": 1050,
        "height": 750,
        "minWidth": 1050,
        "minHeight": 750,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Custom crosshair overlay",
    "longDescription": "A lightweight, native Windows crosshair overlay with a modern settings interface."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3ODUwOEMyRUY0MTZFMEQKUldRTmJrSHZ3Z2lGNTNYdVFFL3FjYWpWZ1ZTRWhtenJqNmtRa3dzOWs1bnlKWk5mUlgyam1Jek8K",
      "endpoints": [
        "https://github.com/msugenius/periscope/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
